# ═══════════════════════════════════════════════════════════
# COGNIX FRONTEND — Environment Variables
# Copy this file to .env and fill in your values
# For Netlify: set these in Site Settings > Environment Variables
# All variables must start with VITE_ to be accessible in the app
# ═══════════════════════════════════════════════════════════

# Backend API URL (set to your Render URL in production, e.g. https://cognix-backend-nukk.onrender.com/api)
VITE_API_BASE_URL=http://localhost:3001/api

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=

# GitHub OAuth Client ID
VITE_GITHUB_CLIENT_ID=
